<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material3 Dark -->
    <style name="Theme.CleverKeyboard" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">#121212</item>
        <item name="android:navigationBarColor">#121212</item>
        <item name="android:windowBackground">#121212</item>
        <item name="colorPrimary">@color/primary_accent</item>
        <item name="colorSecondary">@color/midnight_accent</item>
    </style>

    <!-- Translucent Activity for Permissions -->
    <style name="Theme.CleverKeyboard.Transparent" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>

